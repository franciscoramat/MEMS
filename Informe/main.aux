\@writefile{toc}{\contentsline {section}{\numberline {A}Corrección de fondo}{6}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {A1}{\ignorespaces Barrido representativo antes y después de sustraer el fondo. Las columnas muestran la señal sin y con corrección, y cada panel tiene su propia escala vertical. El fondo de $X$ e $Y$ se ajustó con polinomios cuadráticos fuera de la ventana de resonancia. \textbf  {(a)} y \textbf  {(b)} $X$. \textbf  {(c)} y \textbf  {(d)} $Y$. \textbf  {(e)} y \textbf  {(f)} $R=\sqrt  {X^2+Y^2}$. La excitación es $V_{\mathrm  {ac}}=0{,}11\,\mathrm  {V}$.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:correccion-fondo}{{A1}{6}{Barrido representativo antes y después de sustraer el fondo. Las columnas muestran la señal sin y con corrección, y cada panel tiene su propia escala vertical. El fondo de $X$ e $Y$ se ajustó con polinomios cuadráticos fuera de la ventana de resonancia. \textbf {(a)} y \textbf {(b)} $X$. \textbf {(c)} y \textbf {(d)} $Y$. \textbf {(e)} y \textbf {(f)} $R=\sqrt {X^2+Y^2}$. La excitación es $V_{\mathrm {ac}}=0{,}11\,\mathrm {V}$}{figure.1}{}}
