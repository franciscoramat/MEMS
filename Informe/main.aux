\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {(a)} Barrido de baja amplitud y ajuste del m\'odulo $R$ con un t\'ermino constante m\'as la ra\'iz cuadrada de un perfil lorentziano. \textbf  {(b)} Barrido de ida y vuelta a amplitud mayor.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:lineal-histeresis}{{4}{3}{\textbf {(a)} Barrido de baja amplitud y ajuste del m\'odulo $R$ con un t\'ermino constante m\'as la ra\'iz cuadrada de un perfil lorentziano. \textbf {(b)} Barrido de ida y vuelta a amplitud mayor}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Registro de ringdown del 2 de noviembre a las 16:25. De izquierda a derecha: \textbf  {(a)} señales en CH1 y CH2 alrededor del apagado de la excitación, \textbf  {(b)} envolvente de CH1 con el ajuste exponencial (línea negra discontinua) y \textbf  {(c)} espectrograma de potencia en escala logarítmica. El recuadro del panel central muestra la envolvente y el mismo ajuste en escala semilogarítmica.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:ringdown-1625}{{5}{4}{Registro de ringdown del 2 de noviembre a las 16:25. De izquierda a derecha: \textbf {(a)} señales en CH1 y CH2 alrededor del apagado de la excitación, \textbf {(b)} envolvente de CH1 con el ajuste exponencial (línea negra discontinua) y \textbf {(c)} espectrograma de potencia en escala logarítmica. El recuadro del panel central muestra la envolvente y el mismo ajuste en escala semilogarítmica}{figure.5}{}}
