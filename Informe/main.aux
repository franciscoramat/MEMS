\newlabel{eq:intro-duffing}{{1}{1}{}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Micrografía del resonador A5. En el centro se ven las vigas de la parte móvil y, por encima y por debajo, los electrodos en forma de peine. La barra de escala corresponde a \SI {10}{\micro \metre }. En la parte superior derecha se muestra el anclaje del resonador que conforma sus extremos.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:intro-a5}{{1}{1}{Micrografía del resonador A5. En el centro se ven las vigas de la parte móvil y, por encima y por debajo, los electrodos en forma de peine. La barra de escala corresponde a \SI {10}{\micro \metre }. En la parte superior derecha se muestra el anclaje del resonador que conforma sus extremos}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Respuesta de un oscilador forzado cerca de la resonancia lineal $f_0$. Se comparan el caso lineal y el caso con endurecimiento para una misma amplitud de fuerza. El tramo discontinuo indica soluciones inestables. En el intervalo donde se superponen las dos ramas estables, la respuesta depende del sentido del barrido. Las curvas son teóricas.}}{1}{figure.2}\protected@file@percent }
\newlabel{fig:intro-duffing}{{2}{1}{Respuesta de un oscilador forzado cerca de la resonancia lineal $f_0$. Se comparan el caso lineal y el caso con endurecimiento para una misma amplitud de fuerza. El tramo discontinuo indica soluciones inestables. En el intervalo donde se superponen las dos ramas estables, la respuesta depende del sentido del barrido. Las curvas son teóricas}{figure.2}{}}
\citation{chen-2017}
\@writefile{toc}{\contentsline {section}{\numberline {II}MÉTODO EXPERIMENTAL}{2}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {A}Instrumental y materiales}{2}{section*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Respuesta del resonador en funci\'on de la frecuencia para distintas amplitudes de excitaci\'on. Se muestran los 84 barridos corregidos y, con color, cuatro curvas representativas. El recuadro muestra la frecuencia de corte $f_{\mathrm  {c}}$, definida como la frecuencia muestreada donde $R$ alcanza su m\'aximo. El trazo continuo corresponde al ajuste cuadr\'atico para $V_{\mathrm  {ac}}\le 0.12$ V y el discontinuo al ajuste constante para $V_{\mathrm  {ac}}\ge 0.14$ V.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:barridos-amplitud}{{3}{3}{Respuesta del resonador en funci\'on de la frecuencia para distintas amplitudes de excitaci\'on. Se muestran los 84 barridos corregidos y, con color, cuatro curvas representativas. El recuadro muestra la frecuencia de corte $f_{\mathrm {c}}$, definida como la frecuencia muestreada donde $R$ alcanza su m\'aximo. El trazo continuo corresponde al ajuste cuadr\'atico para $V_{\mathrm {ac}}\le 0.12$ V y el discontinuo al ajuste constante para $V_{\mathrm {ac}}\ge 0.14$ V}{figure.3}{}}
